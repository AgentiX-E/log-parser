{
  "name": "log-parser",
  "private": true,
  "version": "0.1.0",
  "description": "A production-grade, composable intelligent log parsing engine for Node.js and Browser, built on TypeScript with dependency-injection-driven architecture.",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test:coverage",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint 'packages/*/src/**/*.ts' 'packages/*/tests/**/*.ts'",
    "format": "prettier --write 'packages/*/src/**/*.ts' 'packages/*/tests/**/*.ts'",
    "format:check": "prettier --check 'packages/*/src/**/*.ts' 'packages/*/tests/**/*.ts'",
    "ci": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage",
    "clean": "pnpm -r run clean"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

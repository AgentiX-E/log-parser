{
  "name": "@agentix-e/log-parser-node",
  "version": "1.0.0",
  "description": "Node.js I/O adapters for the log-parser framework — filesystem streaming, stdin, and cluster-based parallelism.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --external all --format esm,cjs --dts",
    "dev": "tsup src/index.ts --external all --format esm,cjs --dts --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentix-e/log-parser-core": "workspace:*"
  }
}
